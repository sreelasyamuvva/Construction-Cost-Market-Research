      <aliases enabled='yes' />
      <column caption='Budget-overrun-flag' datatype='integer' datatype-customized='true' name='[Calculation_1916494258614272]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='CASE [How different was the final construction cost from your initial estimate?]&#13;&#10;&#13;&#10;WHEN &quot;Up to 10% higher&quot; THEN 1&#13;&#10;WHEN &quot;10-20% higher&quot; THEN 1&#13;&#10;WHEN &quot;20-30% higher&quot; THEN 1&#13;&#10;WHEN &quot;More than 30% higher&quot; THEN 1&#13;&#10;WHEN &quot;Almost the same&quot; THEN 0&#13;&#10;&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Budget-Overrun-Rate' datatype='real' name='[Calculation_1916494259879937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1916494258614272])&#13;&#10;*&#13;&#10;100&#13;&#10;/&#13;&#10;SUM([Calculation_1916494272544770])' />
      </column>
      <column caption='Valid Cost Response' datatype='integer' name='[Calculation_1916494272544770]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [How different was the final construction cost from your initial estimate?] = &quot;Still under construction / Don&apos;t know&quot;&#13;&#10;THEN NULL&#13;&#10;ELSE 1&#13;&#10;END' />
      </column>
      <column caption='Overrun Percentage' datatype='real' datatype-customized='true' name='[Calculation_1916494276145155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT(IF [How different was the final construction cost from your initial estimate?] = &quot;Up to 10% higher&quot;&#13;&#10;THEN 5&#13;&#10;&#13;&#10;ELSEIF [How different was the final construction cost from your initial estimate?] = &quot;10-20% higher&quot;&#13;&#10;THEN 15&#13;&#10;&#13;&#10;ELSEIF [How different was the final construction cost from your initial estimate?] = &quot;20-30% higher&quot;&#13;&#10;THEN 25&#13;&#10;&#13;&#10;ELSEIF [How different was the final construction cost from your initial estimate?] = &quot;More than 30% higher&quot;&#13;&#10;THEN 35&#13;&#10;&#13;&#10;ELSE NULL&#13;&#10;END)' />
      </column>
      <column caption='Average-Budget-Overrun' datatype='real' datatype-customized='true' name='[Calculation_1916494276431876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_1916494276145155])' />
      </column>
      <column caption='Significant-Overrun-Flag' datatype='integer' name='[Calculation_1916494280986629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [How different was the final construction cost from your initial estimate?] = &quot;20-30% higher&quot;&#13;&#10;OR [How different was the final construction cost from your initial estimate?] = &quot;More than 30% higher&quot;&#13;&#10;THEN 1&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Significant-Overrun-Rate' datatype='real' name='[Calculation_1916494281228294]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1916494280986629])&#13;&#10;*&#13;&#10;100&#13;&#10;/&#13;&#10;SUM([Calculation_1916494272544770])' />
      </column>
      <column caption='Unexpected-Expense-Flag' datatype='integer' name='[Calculation_1916494283673607]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS(&#13;&#10;    [What were the main reasons for the difference between the estimated and actual cost?  (select all that apply)],&#13;&#10;    &quot;Additional/unplanned work&quot;&#13;&#10;)&#13;&#10;OR CONTAINS(&#13;&#10;    [What were the main reasons for the difference between the estimated and actual cost?  (select all that apply)],&#13;&#10;    &quot;Unexpected repairs/issues&quot;&#13;&#10;)&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Unexpected-Expense-Rate' datatype='real' name='[Calculation_1916494284763144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1916494283673607])&#13;&#10;*&#13;&#10;100&#13;&#10;/&#13;&#10;COUNT([Calculation_1916494283673607])' />
      </column>
      <column caption='Estimation-Confidence-Score' datatype='integer' name='[Calculation_1916494287171593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [How confident were you in your initial budget estimate?]&#13;&#10;WHEN &quot;Very confident&quot; THEN 5&#13;&#10;WHEN &quot;Somewhat confident&quot; THEN 4&#13;&#10;WHEN &quot;Neutral&quot; THEN 3&#13;&#10;WHEN &quot;Not very confident&quot; THEN 2&#13;&#10;WHEN &quot;Not confident at all&quot; THEN 1&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Cost-Control Pain Flag' datatype='integer' name='[Calculation_2257618666876929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([Calculation_1916494258614272])&#13;&#10;AND [Calculation_1916494283673607] = 1&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Cost-Control Pain Rate' datatype='real' name='[Calculation_2257618673016834]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2257618666876929]) / COUNT([Respondent ID])' />
      </column>
      <column caption='Solution Adoption Flag' datatype='integer' name='[Calculation_2257618673766403]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [If a tool could provide a reliable estimate of your total construction cost before you begin, based on your location, house siz] = &quot;Definitely would use&quot;&#13;&#10;OR [If a tool could provide a reliable estimate of your total construction cost before you begin, based on your location, house siz] = &quot;Probably would use&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Solution Adoption Rate' datatype='real' name='[Calculation_2257618674094084]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2257618673766403]) / COUNT([Respondent ID])' />
      </column>
      <column caption='Budget Control Difficulty Flag' datatype='integer' name='[Calculation_2257618674704389]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [How difficult was it to keep the construction within your planned budget?] = &quot;Very difficult&quot;&#13;&#10;OR [How difficult was it to keep the construction within your planned budget?] = &quot;Difficult&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Budget Control Difficulty Rate' datatype='real' name='[Calculation_2257618675032070]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2257618674704389]) / COUNT([Respondent ID])' />
      </column>
      <column caption='Active Budget Monitoring Flag' datatype='integer' name='[Calculation_2257618677547015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [How often did you compare actual spending with your planned budget?] = &quot;Daily&quot;&#13;&#10;OR [How often did you compare actual spending with your planned budget?] = &quot;Weekly&quot;&#13;&#10;OR [How often did you compare actual spending with your planned budget?] = &quot;Monthly&quot;&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Active Budget Monitoring Rate' datatype='real' name='[Calculation_2257618677981192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_2257618677547015]) / COUNT([Respondent ID])' />
      </column>
      <column caption='Additional Unplanned Work' datatype='integer' name='[Calculation_2257618815033362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS(&#13;&#10;    [What were the main reasons for the difference between the estimated and actual cost?  (select all that apply)],&#13;&#10;    &quot;Additional/unplanned work&quot;&#13;&#10;)&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Material Price Increase' datatype='integer' name='[Calculation_2257618815873043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS(&#13;&#10;    [What were the main reasons for the difference between the estimated and actual cost?  (select all that apply)],&#13;&#10;    &quot;Increase in material prices&quot;&#13;&#10;)&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Unexpected Repairs' datatype='integer' name='[Calculation_2257618816032788]' role='measure' type='quantitative'>
