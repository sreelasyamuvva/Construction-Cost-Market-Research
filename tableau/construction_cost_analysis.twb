      <style />
      <size maxheight='800' maxwidth='1000' minheight='800' minwidth='1000' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='30875' id='3' layout-strategy-id='distribute-evenly' param='vert' type-v2='layout-flow' w='98400' x='800' y='1000'>
            <zone h='30875' id='5' layout-strategy-id='distribute-evenly' param='horz' type-v2='layout-flow' w='98400' x='800' y='1000'>
              <zone h='30875' id='8' name='KPI-1-Budget-overrun-rate' w='32800' x='800' y='1000'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
